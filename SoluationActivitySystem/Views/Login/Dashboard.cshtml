@model IEnumerable<ActivitySystem.ViewModel.View_Kaizens>

@{
    ViewData["Title"] = "Dashboard - Kaizen Activity System";
    ViewData["Page"] = "Dashboard V1.8.202412031545";
    Layout = "_Main_Layout";
    //ViewBag.DashboardActive = "Active";
}

    <div class="col-md-12">
        <div class="card">
            <div class="card-header ">
                <h5 class="card-title">
                    MyKaizen - มาย! ไคเซ็น
