@model IEnumerable<ActivitySystem.ViewModel.View_ApprovalFlow>
@*@model ActivitySystem.ViewModel.View_ApprovalFlow*@

@{
    ViewData["Title"] = "User Profile - Kaizen Activity System";
    ViewData["Page"] = "User Profile";
    Layout = "_Main_Layout";
}

<div class="row col-md-12">
    <div class="col-md-12">
        <div class="card card-user">
            <div class="card-header">
                <h5 class="card-title">ข้อมูลส่วนตัว / Profile</h5>
            </div>
            <div class="card-body">
                @*(IEnumerable<ActivitySystem.ViewModel.View_ApprovalFlow>)*@
                @foreach (var item in Model)
                {
                <form method="post">
                    <div class="row">
                        <div class="col-md-3 pr-1">
                            <div class="form-group">
                                <label>รหัสพนักงาน / Employee ID</label>
                                <input type="text" class="form-control" disabled="" placeholder="Employee ID"
                                       value="@Html.DisplayFor(modelItem => item.PRS_NO)">
                            </div>
                        </div>
                        <div class="col-md-6 px-1">
                            <div class="form-group">
                                <label>ชื่อนามสกุล / Name Lastname</label>
                                <input type="text" class="form-control" disabled="" placeholder="Name Lastname"
                                       value="@Html.DisplayFor(modelItem => item.EMP_E_NAME) / @Html.DisplayFor(modelItem => item.EMP_INTL)@Html.DisplayFor(modelItem => item.EMP_NAME)  @Html.DisplayFor(modelItem => item.EMP_SURNME)">
                            </div>
                        </div>
                        <div class="col-md-3 pl-1">
                            <div class="form-group">
                                <label>วันเดือนปีเกิด / Birthday</label>
                                <input type="text" class="form-control" disabled="" placeholder="Birthday"
                                       value="@Convert.ToDateTime(item.EMP_BIRTH).ToString("dd/MM/yyyy")">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 pr-1">
                            <div class="form-group">
                                <label>งาน / Job</label>
                                <input type="text" class="form-control" disabled="" placeholder="Job"
                                       value="@Html.DisplayFor(modelItem => item.JBT_ENGDESC) / @Html.DisplayFor(modelItem => item.JBT_THAIDESC)">
                            </div>
                        </div>
                        <div class="col-md-6 pl-1">
                            <div class="form-group">
                                <label>แผนก / Section</label>
                                <input type="text" class="form-control" disabled="" placeholder="Section"
                                       value="@Html.DisplayFor(modelItem => item.DEPT_ENGDESC) / @Html.DisplayFor(modelItem => item.DEPT_THAIDESC)">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 pr-1">
                            <div class="form-group">
                                <label>ฝ่าย / Department</label>
                                <input type="text" class="form-control" disabled="" placeholder="Department"
                                       value="@Html.DisplayFor(modelItem => item.DEPT_CODE)">
                            </div>
                        </div>
                        <div class="col-md-9 pl-1">
                            <div class="form-group">
                                <label for="exampleInputEmail1">Email Address / อีเมล</label>
                                <input type="email" class="form-control" disabled="" placeholder="Email"
                                       value="@Html.DisplayFor(modelItem => item.WBP_EMAIL)">
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="update ml-auto mr-auto">
                                <center>
                                    <img src="~/img/Logo_KAIZEN_FY24.png" alt="MyKaizen" style="width: 50%; height: auto; max-width: 40%" ;>
                                </center>
                                <br />
                   
                        </div>
                    </div>
                </form>
                }
            </div>
        </div>
    </div>
</div>