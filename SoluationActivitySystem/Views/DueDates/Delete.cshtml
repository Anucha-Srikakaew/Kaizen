@model ActivitySystem.Models.DueDate

@{
    ViewData["Title"] = "Due Date Delete - Kaizen Activity System";
    ViewData["Page"] = "Due Date Delete ";
    Layout = "_Main_Layout";
}

<div class="row col-md-12">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3>Are you sure you want to delete this?</h3>
                <h5 class="card-title">
                    รายละเอียดรอบกิจกรรม / Due Date Detail
                </h5>
            </div>
            <div class="card-body">
                <dl class="dl-horizontal">
                    <dt>
                        @Html.DisplayNameFor(model => model.StartingDate)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.StartingDate)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.EndingDate)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.EndingDate)
                    </dd>
                </dl>
                <div>
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="DueDateNo" />
                        <input type="submit" value="Delete" class="btn btn-default" /> |
                        <i class="fa fa-history"></i><a asp-action="Index"> Back to List</a>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

