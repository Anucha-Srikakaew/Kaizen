@model IEnumerable<ActivitySystem.ViewModel.View_Kaizens>

@{
    ViewData["Title"] = "My Kaizen - Kaizen Activity System";
    ViewData["Page"] = "My Kaizen";
    Layout = "_Main_Layout";
}

<script>
    var showAlert = "@ViewBag.showAlert";
    var alertMessage = "@ViewBag.alertMessage";
    if (showAlert === "True") {
        alert(alertMessage);
    }
</script>

<div class="row col-md-12">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">
                    รายการของฉัน / My Library
                </h5>
            </div>
            <div class="card-body">
                <div class="container dl-horizontal">
                    <form asp-controller="Kaizens" asp-action="Index" method="post">
                        <div class=" row form-group">
                            <div class="col-md-3 pr-1">
                                <label class="control-label">ค้นหาตามรอบกิจกรรม </br>(Due Date):</label>
                            </div>
                            <div class="col-md-6 pr-1">
                                <select class="form-control" asp-items="ViewBag.DueDate" name="searchNo" onchange="clickMe()">
                                    <option selected>--- แสดงผลทั้งหมด ---</option>
                                </select>
                            </div>
                            <div class="col-md-3 pr-0">
                                <button type="submit" value="Search" class="btn btn-primary">
                                    <div style="color: white" text-align: center;>Search</div>
                                </button>
                            </div>
                        </div>
                        <div class=" row form-group">
                            <div class="col-md-3 pr-0">
                                <label class="control-label">จำนวนเรื่องที่ส่ง </br>(Kaizen Count):</label>
                            </div>
                            <div class="col-md-1 pr-0">
                                <label class="control-label">@ViewBag.CntKaizen</label>
                            </div>
                            <div class="col-md-3 pr-0">
                                <label class="control-label">จำนวนเงินที่ลด </br>(CR Sum.):</label>
                            </div>
                            <div class="col-md-1 pr-0" align="left">
                                <label class="control-label" align="left">@ViewBag.SumPrice</label>
                            </div>
                            <div class="col-md-3 pr-0">
                                <label class="control-label">จำนวนเงินรางวัล </br>(Award Price):</label>
                            </div>
                            <div class="col-md-1 pr-0" align="left">
                                <label class="control-label" align="left">@ViewBag.SumPrice</label>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card-body">
                <div class="container1">
                    <div class=" row form-group">
                        <div class="col-md-2 pr-0">
                            <label class="control-label">คำค้นหา (Search): </label>
                        </div>
                        <div class="col-md-10 pr-0">
                            <label class="control-label" align="left">@ViewBag.Search</label>
                        </div>
                    </div>
                    <table class="table table-striped table-hover" id="dtBasicExample" cellspacing="0" width="100%">
                        <thead>
                            <tr>
                                <th align="center">
                                    Kaizen No.
                                </th>
                                <th align="center">
                                    Title
                                </th>
                                <th align="center">
                                    Date
                                </th>
                                <th align="center">
                                    Type
                                </th>
                                <th align="center">
                                    Detail
                                </th>
                                <th align="right">
                                    Cost Saving
                                </th>
                                <th align="center">
                                    Status
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    if(item != null)
                                    {
                                        <tr>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.KaizenRef)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Title)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Date)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ActTypeTh)
                                                /
                                                @Html.DisplayFor(modelItem => item.ActTypeEng)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ActDetail)
                                            </td>
                                            <td align="right">
                                                @Html.DisplayFor(modelItem => item.CostSaving)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.KzStatus)
                                            </td>
                                            <td>

                                                <a asp-action="Details" asp-route-id="@item.KaizenNo" target="_blank">Detail</a>
                                                @if (item.KzStatus == "NewIdea" )
                                                {
                                                    <b>| </b><a asp-action="Edit" asp-route-id="@item.KaizenNo">Edit</a> <b> |</b>
                                                }
                                                @if (item.KzStatus == "NewIdea" )
                                                {
                                                    <a asp-action="Delete" asp-route-id="@item.KaizenNo">Delete</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="12" align="center">No records found.</td>
                                        </tr>
                                    }
                                   
                                }
                            }
                            else
                            {
                            <tr>
                                <td colspan="12" align="center">No records found.</td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    @*<script src="https://code.jquery.com/jquery-1.12.4.min.js"
                integrity="sha256-ZosEbRLbNQzLpnKIkEdrPv7lOy9C27hHQ+Xp8a4MxAQ="
                crossorigin="anonymous"></script>
        <script>
            $(document).ready(function () {
                $('select').change(function () {
                    $('a').attr('asp-route-id', $(this).children('option:selected').val());
                })
            })
        </script>*@

    <script type="text/javascript">
        $(".custom-file-input-before").on("change", function () {
            var fileName = $(this).val().split("\\").pop();
            $(this).siblings(".custom-file-label-before").addClass("selected").html(fileName);
        });
        $(".custom-file-input-after").on("change", function () {
            var fileName = $(this).val().split("\\").pop();
            $(this).siblings(".custom-file-label-after").addClass("selected").html(fileName);
        });
    </script>



    <script>
        $(document).ready(function () {
            $('#dtBasicExample').DataTable({
                order: [[7, 'desc']]
            });
        });
    </script>

   
}










