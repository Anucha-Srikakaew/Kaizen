@model ActivitySystem.Models.Kaizen

@{
    ViewData["Title"] = "New Topic - Kaizen Activity System";
    ViewData["Page"] = "New Topic";
    Layout = "_Main_Layout";
}

<div class="row col-md-12">
    <div class="col-md-12">

        <div class="card">

            <div class="card-header">
                <h5 class="card-title">
                    สร้างเอกสาร / Create Kaizen
                </h5>
            </div>
            <div class="card-body">
                <div class="container">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row form-group">
                            <div class="col-md-3 pr-1">
                                <label asp-for="Title" class="control-label">หัวข้อเรื่อง </br>(Topic):</label>
                            </div>
                            <div class="col-md-9 pr-0">
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-md-3 pr-0">
                                <label asp-for="Date" class="control-label">วันที่เสนอแนะ </br>(Date):</label>
                            </div>
                            <div class="col-md-3 pr-0">
                                <input class="form-control" value="@ViewBag.DateNow" disabled></input>
                                <span asp-validation-for="Date" class="text-danger"></span>
                            </div>

                            <div class="row form-group col-md-6 pr-0">

                                <div class="col-md-2 pr-0">
                                    <label asp-for="Date" class="control-label"><p style="color:red">*** สำคัญ</p></label>
                                </div>
                                <div class="col-md-10 pr-0">
                                    <label asp-for="Date" class="control-label">วันที่เสนอแนะ Kaizen จะเปลี่ยนเป็นวันที่ผู้อนุมัติผลงาน (ผู้จัดการ) กดอนุมัติวันสุดท้าย (รอบผลงานอ้างอิงวันสุดท้ายที่อนุมัติ)</label>
                                </div>
                              
                            </div>


                        </div>
                        <div class="row form-group">
                            <div class="col-md-3 pr-0">
                                <label asp-for="NoActType" class="control-label">ประเภทของกิจกรรม </br>(Kaizen Type):</label>
                            </div>
                            <div class="col-md-3 pr-0">
                                @Html.DropDownListFor(model => model.NoActType, (SelectList)ViewBag.ActType, "-- Select Kaizen Type --", htmlAttributes: new { @id = "NoActType", @class = "form-control", onchange = "clickMe()" })
                                @Html.ValidationMessageFor(model => model.NoActType, "", new { @class = "text-danger" })
                            </div>

                            <div class="row form-group col-md-6 pr-0" id="ShowActContent">

                                <div class="col-md-4 pr-0">
                                    <label asp-for="ActDetail" class="control-label">อื่น ๆ โปรดระบุ </br>(Other):</label>
                                </div>
                                <div class="col-md-8 pr-0">
                                    <input asp-for="ActDetail" class="form-control" />
                                    <span asp-validation-for="ActDetail" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="card-header">
                            <h6 class="card-title">
                                ก่อนปรับปรุง/ปัญหา (Before Improve/Present Problem):
                            </h6>
                        </div>

                        <div class="row form-group">
                            <div class="col-md-3 pr-0">
                                <label asp-for="ImageBefore" class="control-label">รูปภาพก่อนการปรับปรุง (Before Image)</label>
                            </div>

                            <div class="col-md-4 pr-0">
                         
                               <!-- Hidden file input for the captured image -->
                                <input asp-for="ImageBefore" class="custom-file-input-before" id="customFile" accept="image/jpeg" />
                                <label class="custom-file-label-before" for="customFile" id="fileNameLabel">

									<button type="button" class="btn cur-p btn-outline-success"><i class="fa fa-folder-open"></i> คลิกเลือกไฟล์รูปภาพเท่านั้น </button>
                                    
                                </label>
                            </div>
                            <div class="col-md-5 pr-0">
                                <button onclick="myFunctionBefore()" type="button" class="btn cur-p btn-outline-primary"><i class="fa fa-camera-retro"></i> เปิด/ปิดกล้องหลังถ่ายรูป </button>
                            </div>

                            <div class="col-md-3 pr-0">
								
                            </div>

                            <div class="col-md-9 pr-0">
                                    

                                <div id="myDIVBefore" style="display: none;">

                                    <!-- Video element for camera preview -->
                                    <video id="video" width="320" height="240" autoplay></video>

                                    <!-- Canvas to draw the captured image (hidden by default) -->
                                    <canvas id="canvas" width="320" height="240" style="display: none;" ></canvas>
                                    <br />
                                    <!-- Button to capture photo from video stream -->
                                    <button type="button" id="captureBtn" class="btn btn-warning" ><i class="fa fa-camera"></i> ถ่ายรูป Capture Photo </button>

                                    <!-- Display captured image -->   
                                    <img id="capturedImage" style="display: none;"  alt="Captured Image" />

                                    <!-- Hidden input to store the base64 encoded image -->
                                    <input type="hidden" id="hiddenImageBefore" name="ImageBefore" />

                                   @*  <span asp-validation-for="ImageBefore" class="text-danger"></span> *@
                                </div>

                            </div>

                        </div>

                        <div class="row form-group">
                            <div class="col-md-3 pr-0">
                                <label asp-for="Problem" class="control-label">ปัญหาที่พบ </br>(Problem):</label>
                            </div>
                            <div class="col-md-9 pr-0">
                                <textarea rows="4" asp-for="Problem" class="form-control" maxlength="3000"></textarea>
                                <span asp-validation-for="Problem" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="card-header">
                            <h6 class="card-title">
                                หลังปรับปรุง/สิ่งที่คาดว่าจะเป็น (After Improve):
                            </h6>
                        </div>


                        <div class="row form-group">
                            <div class="col-md-3 pr-0">
                                <label asp-for="ImageAfter" class="control-label">รูปภาพหลังการปรับปรุง (After Image)</label>
                            </div>
                            <div class="col-md-4 pr-0">
 
                                <!-- Hidden file input for the captured image -->
                                <input asp-for="ImageAfter" class="custom-file-input-after" id="customFileAfter" accept="image/jpeg" />

                                <label class="custom-file-label-after" for="customFileAfter" id="fileNameLabelAfter">
                                    
                                    <button type="button" class="btn cur-p btn-outline-success"><i class="fa fa-folder-open"></i> คลิกเลือกไฟล์รูปภาพเท่านั้น </button>

                                </label>
                              
                            </div>
                            <div class="col-md-5 pr-0">
                                <button onclick="myFunctionAfter()" type="button" class="btn cur-p btn-outline-primary"><i class="fa fa-camera-retro"></i> เปิด/ปิดกล้องหลังถ่ายรูป </button>
                            </div>

                            <div class="col-md-3 pr-0">

                            </div>

                            <div class="col-md-9 pr-0">

                                <div id="myDIVAfter" style="display: none;">

                                    <!-- Video element for camera preview -->
                                    <video id="videoAfter" width="320" height="240" autoplay></video>

                                    <!-- Canvas to draw the captured image (hidden by default) -->
                                    <canvas id="canvasAfter" width="320" height="240" style="display: none;"></canvas>
                                    <br />
                                    <!-- Button to capture photo from video stream -->
                                    <button type="button" id="captureBtnAfter" class="btn btn-warning" ><i class="fa fa-camera"></i> ถ่ายรูป Capture Photo </button>

                                    <!-- Display captured image -->
                                    <img id="capturedImageAfter" style="display:none;" alt="Captured Image" />

                                    <!-- Hidden input to store the base64 encoded image -->
                                    <input type="hidden" id="hiddenImageAfter"  name="ImageAfter" />

                                    @* <span asp-validation-for="ImageAfter" class="text-danger"></span> *@
                                </div>

                            </div>
                        </div>



                        <div class="row form-group">
                            <div class="col-md-3 pr-0">
                                <label asp-for="Result" class="control-label">ผลที่ได้ </br>(Result):</label>
                            </div>
                            <div class="col-md-9 pr-0">
                                <textarea rows="4" asp-for="Result" class="form-control" maxlength="3000"></textarea>
                                <span asp-validation-for="Result" class="text-danger"></span>
                            </div>
                        </div>

                        <br />
                        <div class="row form-group">
                            <div class="col-md-3 pr-0">
                                <label asp-for="CostSaving" class="control-label">จำนวนเงินที่สามารถลดได้ </br>(Cost Saving):</label>
                            </div>
                            <div class="col-md-3 pr-0">
                                <input asp-for="CostSaving" class="form-control" value="0.00" type="number" />
                                <span asp-validation-for="CostSaving" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 pr-0">
                                <label class="control-label">บาท </br>(Baht)</label>
                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-md-12 pr-0">
                                <div class="row update ml-auto mr-auto">
                                    <button type="submit" value="Create" class="btn btn-primary btn-round" >
                                        <div style="color: white" text-align: center;>สร้างเอกสารไคเซ็น Create</div>
                                    </button> 
                                </div>

                                <div class="row update ml-auto mr-auto">
                                    <span class="text-primary">* อย่าลืมกดส่งไคเซ็นหลังสร้างเอกสาร หน้า Detail</span>
                                </div>
                            </div>
                        </div>
                    </form>

@* 
                    <div class="row form-group">
                        <div class="col-md-12 pr-0">
                            <div class="row update ml-auto mr-auto">
                               

                                <input asp-action="Create" type="submit" value="สร้างเอกสารไคเซ็น Create" class="btn btn-success btn-round" />

                            </div>


                            <input asp-action="SendCrateAndApproval" type="submit" value="สร้างเอกสารและส่งเรื่องไคเซ็น Create AND Send To Approval" class="btn btn-success btn-round" />

                        </div>
                    </div>
 *@
                    @*<form asp-action="CreateAndSendApproval">
                        <input type="hidden" asp-for="KaizenNo" />
                        <input type="submit" value="สร้างและส่งเรื่องไคเซ็น Create & Send To Approval" class="btn btn-warning" />
                    </form>*@

                </div>

            </div>
            <div class="card-footer ">
                @*<hr>*@
                <div class="stats">
                    <i class="fa fa-history"></i>
                    <a asp-action="Index">Back to MyKaizen</a>
                </div>
            </div>
        </div>
    </div>
</div>


