     <script type="text/javascript">
        $(".custom-file-input-before").on("change", function () {
            var fileName = $(this).val().split("\\").pop();
            $(this).siblings(".custom-file-label-before").addClass("selected").html(fileName);
        });
        $(".custom-file-input-after").on("change", function () {
            var fileName = $(this).val().split("\\").pop();
            $(this).siblings(".custom-file-label-after").addClass("selected").html(fileName);
        });
    </script>


    <script>
        let videoStreamBefore = null;
        let videoStreamAfter = null;

        // Helper function to start video stream with back camera (environment)
        function startVideoStream(videoElement, videoStreamSetter) {
            if (videoStreamSetter) {
                videoStreamSetter.getTracks().forEach(track => track.stop());
            }

            // Request the back camera (environment)
            navigator.mediaDevices.getUserMedia({
                video: { facingMode: { exact: "environment" } } // Use back camera
            })
                .then(function (stream) {
                    videoElement.srcObject = stream;

                    if (videoElement.id === 'video') {
                        videoStreamBefore = stream;
                    } else {
                        videoStreamAfter = stream;
                    }
                })
                .catch(function (err) {
                    console.error("Error accessing the camera: ", err);
                    alert(`Unable to access the back camera: ${err.message}. Please check permissions/device.`);
                });
        }

        // Function to toggle display and start "Before" video stream
        function myFunctionBefore() {
            var x = document.getElementById("myDIVBefore");
            if (x.style.display === "none") {
                x.style.display = "block";
                const video = document.getElementById('video');
                startVideoStream(video, videoStreamBefore);
            } else {
                x.style.display = "none";
            }
        }

        // Function to toggle display and start "After" video stream
        function myFunctionAfter() {
            var x = document.getElementById("myDIVAfter");
            if (x.style.display === "none") {
                x.style.display = "block";
                const videoAfter = document.getElementById('videoAfter');
                startVideoStream(videoAfter, videoStreamAfter);
            } else {
                x.style.display = "none";
            }
        }

        // Capture image function for Before and After sections
        function captureImage(videoElement, canvasElement, capturedImageElement, hiddenImageInput, customFileInput, fileNameLabel) {
            const context = canvasElement.getContext('2d');
            canvasElement.width = videoElement.videoWidth;
            canvasElement.height = videoElement.videoHeight;
            context.drawImage(videoElement, 0, 0, canvasElement.width, canvasElement.height);

            const imageData = canvasElement.toDataURL('image/jpeg');
            capturedImageElement.src = imageData;
            capturedImageElement.style.display = 'block';
            hiddenImageInput.value = imageData;

            // Convert base64 to Blob and update the file input
            fetch(imageData)
                .then(res => res.blob())
                .then(blob => {
                    const file = new File([blob], `capture_${new Date().toISOString().replace(/[:.-]/g, '').slice(0, 15)}.jpg`, { type: "image/jpeg" });
                    const dataTransfer = new DataTransfer();
                    dataTransfer.items.add(file);
                    customFileInput.files = dataTransfer.files;
                    fileNameLabel.textContent = file.name;
                });
        }

        // Capture button for Before section
        const captureBtn = document.getElementById('captureBtn');
        const canvas = document.getElementById('canvas');
        const capturedImage = document.getElementById('capturedImage');
        const hiddenImageBefore = document.getElementById('hiddenImageBefore');
        const customFileInput = document.getElementById('customFile');
        const fileNameLabel = document.getElementById('fileNameLabel');
        captureBtn.addEventListener('click', function () {
            captureImage(video, canvas, capturedImage, hiddenImageBefore, customFileInput, fileNameLabel);
        });

        // Capture button for After section
        const captureBtnAfter = document.getElementById('captureBtnAfter');
        const canvasAfter = document.getElementById('canvasAfter');
        const capturedImageAfter = document.getElementById('capturedImageAfter');
        const hiddenImageAfter = document.getElementById('hiddenImageAfter');
        const customFileInputAfter = document.getElementById('customFileAfter');
        const fileNameLabelAfter = document.getElementById('fileNameLabelAfter');
        captureBtnAfter.addEventListener('click', function () {
            captureImage(videoAfter, canvasAfter, capturedImageAfter, hiddenImageAfter, customFileInputAfter, fileNameLabelAfter);
        });
    </script>




}
