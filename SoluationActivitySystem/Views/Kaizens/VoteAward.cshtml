@model IEnumerable<ActivitySystem.ViewModel.View_Kaizens>

@{
    ViewData["Title"] = "Admin (SGA Board) - Kaizen Activity System";
    ViewData["Page"] = "Award Vote by SGA Board";
    Layout = "_Main_Layout";
}


<style>
    table.dataTable thead .sorting:after,
    table.dataTable thead .sorting:before,
    table.dataTable thead .sorting_asc:after,
    table.dataTable thead .sorting_asc:before,
    table.dataTable thead .sorting_asc_disabled:after,
    table.dataTable thead .sorting_asc_disabled:before,
    table.dataTable thead .sorting_desc:after,
    table.dataTable thead .sorting_desc:before,
    table.dataTable thead .sorting_desc_disabled:after,
    table.dataTable thead .sorting_desc_disabled:before {
        bottom: .5em;
    }
</style>

<div class="row col-md-12">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">
                    รายการโหวตไคเซ็นประจำเดือน / Kaizen Award Vote List by SGA Board
                </h5>
            </div>
            <div class="card-body">
                <div class="container dl-horizontal">
                    <form asp-controller="Kaizens" asp-action="VoteAward" method="post">
                        <div class=" row form-group">
                            <div class="col-md-2 pr-1">
                                <label class="control-label">ค้นหาตามรอบกิจกรรม </br>(Due Date):</label>
                            </div>
                            <div class="col-md-8 pr-1">
                                <select class="form-control" asp-items="ViewBag.DueDate" name="searchNo" onchange="clickMe()">
                                    <option selected>--- แสดงผลทั้งหมด ---</option>
                                </select>
                            </div>
                            <div class="col-md-2 pr-0">
                                <button type="submit" value="Search" class="btn btn-primary">
                                    <div style="color: white" text-align: center;>Search</div>
                                </button>
                            </div>
                        </div>
                        <div class=" row form-group">
                            <div class="col-md-2 pr-1">
                                <label class="control-label">ค้นหาตามแผนก </br>(Department):</label>
                            </div>
                            <div class="col-md-8 pr-1">
                                <select class="form-control" asp-items="ViewBag.DeptTab" name="searchDept" onchange="clickMe()">
                                    <option selected>--- แสดงผลทั้งหมด ---</option>
                                </select>
                            </div>
                        </div>
                        <div class=" row form-group">
                            <div class="col-md-3 pr-0">
                                <label class="control-label">จำนวนเรื่องที่ส่ง </br>(Kaizen Count):</label>
                            </div>
                            <div class="col-md-1 pr-0">
                                <label class="control-label">@ViewBag.CntKaizen</label>
                            </div>
                            <div class="col-md-3 pr-0">
                                <label class="control-label">จำนวนเงินที่ลด </br>(CR Sum.):</label>
                            </div>
                            <div class="col-md-1 pr-0" align="left">
                                <label class="control-label" align="left">@ViewBag.SumPrice</label>
                            </div>
                            <div class="col-md-3 pr-0">
                                <label class="control-label">จำนวนเงินรางวัล </br>(Award Price):</label>
                            </div>
                            <div class="col-md-1 pr-0" align="left">
                                <label class="control-label" align="left">@ViewBag.SumPrice</label>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card-body">
                <div class="container1">
                    <div class=" row form-group">
                        <div class="col-md-2 pr-0">
                            <label class="control-label">คำค้นหา (Search): </label>
                        </div>
                        <div class="col-md-10 pr-0">
                            <label class="control-label" align="left">@ViewBag.Search</label>
                        </div>	
                    </div>
					<table class="table table-striped table-hover" id="dtBasicExample" cellspacing="0" width="100%">
						<thead >
							<tr>
								<th align="center">
									Kaizen No.
								</th>
								<th align="center">
									EMP ID
								</th>
								<th align="center">
									EMP Name
								</th>
								<th align="center">
									Title
								</th>
								<th align="center">
									Date
								</th>
								<th align="center">
									Chk. Cost Saving
								</th>
								<th align="center">
									Status
								</th>
								<th align="center">
									Kaizen
								</th>
								<th align="center">
									CR
								</th>
								<th align="center">
									Vote
								</th>
								<th></th>
								<th align="center">
									ChkType
								</th>
								<th align="center">
									Award
								</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							@if (Model != null )
							{
								@foreach (var item in Model)
								{
									@if (item != null)
									{
									<tr>
										<td>
											@Html.DisplayFor(modelItem => item.KaizenRef)
										</td>
										<td>
											@Html.DisplayFor(modelItem => item.IdEmp)
										</td>
										<td>
											@Html.DisplayFor(modelItem => item.NameEmp)
										</td>
										<td>
											@Html.DisplayFor(modelItem => item.Title)
										</td>
										<td>
											@Html.DisplayFor(modelItem => item.Date)
										</td>
										<td align="right">
											@Html.DisplayFor(modelItem => item.ChkCost)
										</td>
										<td>
											@Html.DisplayFor(modelItem => item.KzStatus)
										</td>
										<td>
											@Html.DisplayFor(modelItem => item.CntKaizen)
										</td>
										<td>
											@Html.DisplayFor(modelItem => item.CntCR)
										</td>
										<td>
											@Html.DisplayFor(modelItem => item.CntVote)
										</td>
										<td>
											<a asp-action="LibraryDetails" asp-route-id="@item.KaizenNo" target="_blank">Detail</a>
										</td>
										<form asp-action="VoteAwardClick" method="post">
											<input type="hidden" name="KaizenNo" value="@item.KaizenNo" />
											<td>
												<select class="form-control" name="NoType" asp-for="@item.NoType" asp-items="ViewBag.ChkType" value="@item.ChkType"></select>
											</td>
											<td align="center">
												<select class="form-control" name="AwardNo" asp-for="@item.AwardNo" asp-items="ViewBag.Award"></select>
											</td>
											<td align="center">
													@if (item.KzStatus == "Vote" || item.KzStatus == "Award")
													{
													<button type="submit" value="Award" class="btn btn-primary btn-round">
														<div style="color: white" text-align: center;>Save</div>
													</button>
													}
											</td>
										</form>
									</tr>
									}
									else
									{
										<tr>
											<td colspan="13" align="center">No records found.</td>
										</tr>
									}
								}
							}
							else
							{
								<tr>
									<td colspan="12" align="center">No records found.</td>
								</tr>
							}
						</tbody>
					</table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        var showAlert = "@ViewBag.showAlert";
        var alertMessage = "@ViewBag.alertMessage";
        if (showAlert === "True") {
            alert(alertMessage);
        }
    </script>

	<script>
		$(document).ready(function () {
			$('#dtBasicExample').DataTable({
				order: [[11, 'desc']]
			});
		});
	</script>

}




