@model IEnumerable<ActivitySystem.ViewModel.View_Kaizens>

@{
    ViewData["Title"] = "Manager - Kaizen Activity System";
    ViewData["Page"] = "Manager";
    Layout = "_Main_Layout";
}

<script>
    var showAlert = "@ViewBag.showAlert";
    var alertMessage = "@ViewBag.alertMessage";
    if (showAlert === "True") {
        alert(alertMessage);
    }
</script>

<div class="row col-md-12">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">
                    รายการไคเซ็นรออนุมัติโดยผู้จัดการ / Kaizen List Of Manager
                </h5>
            </div>
            <div class="card-body">
                <div class="container dl-horizontal">
                    <form asp-controller="Kaizens" asp-action="Approval" method="post">
                        <div class=" row form-group">
                            <div class="col-md-3 pr-1">
                                <label class="control-label">ค้นหาตามรอบกิจกรรม </br>(Due Date):</label>
                            </div>
                            <div class="col-md-6 pr-1">
                                <select class="form-control" asp-items="ViewBag.DueDate" name="searchNo" onchange="clickMe()">
                                    <option selected>--- แสดงผลทั้งหมด ---</option>
                                </select>
                            </div>
                            <div class="col-md-3 pr-0">
                                <button type="submit" value="Search" class="btn btn-primary">
                                    <div style="color: white" text-align: center;>Search</div>
                                </button>
                            </div>
                        </div>
                        <div class=" row form-group">
                            <div class="col-md-3 pr-0">
                                <label class="control-label">จำนวนเรื่องที่ส่ง </br>(Kaizen Count):</label>
                            </div>
                            <div class="col-md-1 pr-0">
                                <label class="control-label">@ViewBag.CntKaizen</label>
                            </div>
                            <div class="col-md-3 pr-0">
                                <label class="control-label">จำนวนเงินที่ลด </br>(CR Sum.):</label>
                            </div>
                            <div class="col-md-1 pr-0" align="left">
                                <label class="control-label" align="left">@ViewBag.SumPrice</label>
                            </div>
                            <div class="col-md-3 pr-0">
                                <label class="control-label">จำนวนเงินรางวัล </br>(Award Price):</label>
                            </div>
                            <div class="col-md-1 pr-0" align="left">
                                <label class="control-label" align="left">@ViewBag.SumPrice</label>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card-body">
                <div class="container1">
                    <div class=" row form-group">
                        <div class="col-md-2 pr-0">
                            <label class="control-label">คำค้นหา (Search): </label>
                        </div>
                        <div class="col-md-10 pr-0">
                            <label class="control-label" align="left">@ViewBag.Search</label>
                        </div>
                    </div>
                    @*<form asp-action="Approval" enctype="multipart/form-data">*@
                    <table class="table table-striped table-hover" id="dtBasicExample" cellspacing="0" width="100%">
                        <thead>
                            <tr>
                                <th align="center" width="400px">
                                    Kaizen No.
                                </th>
                                <th align="center">
                                    EMP ID
                                </th>
                                <th align="center">
                                    EMP NAME
                                </th>
                                <th align="center" width="500px">
                                    Title
                                </th>
                                <th align="center">
                                    Date
                                </th>
                                <th align="center" width="500px">
                                    Type
                                </th>
                                <th align="center" width="500px">
                                    Detail
                                </th>
                                <th align="center" width="1100px">
                                    Cost Saving
                                </th>
                                <th align="center" width="300px">
                                    Status
                                </th>
                                <th width="100px" align="center">Award</th>
                                <th width="100px" align="center">CR</th>
                                <th width="100px" align="center">Vote</th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    if (item != null)
                                    {
                                        <tr>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.KaizenRef)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.IdEmp)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.NameEmp)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Title)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Date)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ActTypeTh)
                                                /
                                                @Html.DisplayFor(modelItem => item.ActTypeEng)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ActDetail)
                                            </td>
                                            <td align="right">
                                                @Html.DisplayFor(modelItem => item.CostSaving)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.KzStatus)
                                            </td>
                                            <form asp-action="ApprovalClick" method="post">
                                                <td align="center" width="70px">
                                                    <select class="form-control" name="CntKaizen">
                                                        <option selected value="1">Yes</option>
                                                        <option value="2">No</option>
                                                    </select>
                                                </td>
                                                <td align="center" width="70px">
                                                    <select class="form-control" name="CntCR">
                                                        <option value="1">New</option>
                                                        <option value="2">Currently</option>
                                                        <option selected value="3">N/A</option>
                                                    </select>
                                                </td>
                                                <td align="center" width="70px">
                                                    <select class="form-control" name="CntVote">
                                                        <option value="1">Yes</option>
                                                        <option selected value="2">No</option>
                                                    </select>
                                                </td>
                                                <td align="center">
                                                    <a asp-action="LibraryDetails" asp-route-id="@item.KaizenNo" target="_blank">Detail</a>
                                                </td>
                                                <td align="center">
                                                    <input type="hidden" name="KaizenNo" value="@item.KaizenNo" />
                                                    @* @if (item.KzStatus == "WaitManager")
                                                    { *@
                                                        @*<a asp-action="Approval" sp-route-id="@item.KaizenNo">*@
                                                        <button type="submit" value="Approval" class="btn btn-primary btn-round">
                                                            <div style="color: white" text-align: center;>Approval</div>
                                                        </button>
                                                        @*</a>*@
                                                   @*  } *@
                                                </td>
                                            </form>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="12" align="center">No records found.</td>
                                        </tr>
                                    }
                                }
                            }
                            else
                            {  <tr>
                                    <td colspan="12" align="center">No records found.</td>
                               </tr>
                            }
                        </tbody>
                    </table>
                    @*</form>*@
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            $('#dtBasicExample').DataTable();
        });
    </script>
}






